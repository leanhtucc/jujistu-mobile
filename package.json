{
  "name": "jujistu",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "cross-env JUJISTU_ENV=development react-native run-android",
    "android:production": "cross-env JUJISTU_ENV=production react-native run-android",
    "android:staging": "cross-env JUJISTU_ENV=staging react-native run-android",
    "architecture:check": "node scripts/check-architecture.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons:generate": "node scripts/generate-icons.js",
    "ios": "cross-env JUJISTU_ENV=development react-native run-ios",
    "ios:production": "cross-env JUJISTU_ENV=production react-native run-ios",
    "ios:staging": "cross-env JUJISTU_ENV=staging react-native run-ios",
    "lint": "eslint .",
    "start": "cross-env JUJISTU_ENV=development react-native start --reset-cache",
    "start:production": "cross-env JUJISTU_ENV=production react-native start --reset-cache",
    "start:staging": "cross-env JUJISTU_ENV=staging react-native start --reset-cache",
    "test": "jest",
    "test:ci": "jest --ci --runInBand",
    "typecheck": "tsc --noEmit",
    "verify": "npm run format:check && npm run lint && npm run architecture:check && npm run typecheck && npm run test:ci"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.87.1",
    "@react-navigation/native": "7.3.18",
    "@react-navigation/native-stack": "7.18.10",
    "@tanstack/react-query": "5.102.8",
    "nativewind": "4.2.6",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-keychain": "10.0.0",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "5.9.1",
    "react-native-screens": "4.27.0",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "0.12.2",
    "tailwindcss": "3.4.19"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@svgr/cli": "8.1.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "cross-env": "10.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "lightningcss": "1.33.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "22.16.x",
    "npm": "10.9.x"
  },
  "packageManager": "npm@10.9.2"
}
