{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "paths": {
      "@jujistu/ui": ["./src/ui/index.ts"],
      "@jujistu/app/*": ["./src/app/*"],
      "@jujistu/features/*": ["./src/features/*"],
      "@jujistu/shared/*": ["./src/shared/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "nativewind-env.d.ts"],
  "exclude": ["**/node_modules", "**/Pods"]
}
