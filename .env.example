# JUJISTU Environment Variables (Example Template)
# Copy this file to .env.development or .env.production and customize your values.
#
# IMPORTANT: Never commit actual credentials, private keys, or tokens to version control.
# Only .env.example is public; .env.* files are ignored by git.

# Application Metadata
APP_DISPLAY_NAME=JUJISTU
APP_ANDROID_PACKAGE=com.jujistu.app
APP_IOS_BUNDLE_IDENTIFIER=com.jujistu.app

# API Configuration
API_BASE_URL=https://api-dev.jujistu.app
API_DEBUG=true

# Error Reporting & Diagnostics (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TEST_ON_LAUNCH=false
